// Prisma schema for the ReachInbox Email Job Scheduler.
// PostgreSQL is the application's single source of truth.
// Redis/BullMQ only holds queue execution state derived from this data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  scheduled
  processing
  sent
  failed
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders          Sender[]
  campaigns        Campaign[]
  emails           Email[]
  slackConnection  SlackConnection?

  @@map("users")
}

model Sender {
  id          String   @id @default(uuid())
  userId      String
  email       String
  displayName String
  // SMTP credentials for this sender. Never serialized to the frontend -
  // repositories/controllers must explicitly select fields, this column is
  // excluded from every DTO mapper.
  smtpUser     String?
  smtpPassword String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  emails    Email[]

  @@unique([userId, email])
  @@index([userId])
  @@map("senders")
}

model Campaign {
  id                 String   @id @default(uuid())
  userId             String
  senderId           String
  subject            String
  body               String
  startTime          DateTime
  delayBetweenEmails Int      @default(2)
  hourlyLimit        Int      @default(100)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emails Email[]

  @@index([userId])
  @@index([senderId])
  @@map("campaigns")
}

model Email {
  id                 String      @id @default(uuid())
  campaignId         String
  userId             String
  senderId           String
  recipient          String
  subject            String
  body               String
  scheduledAt        DateTime
  status             EmailStatus @default(scheduled)
  bullJobId          String?     @unique
  attempts           Int         @default(0)
  sentAt             DateTime?
  failedAt           DateTime?
  errorMessage        String?
  providerMessageId   String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([senderId])
  @@index([campaignId])
  @@index([recipient])
  @@index([userId, status])
  @@map("emails")
}

model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  teamId      String
  teamName    String
  accessToken String
  channelId   String?
  botUserId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("slack_connections")
}
