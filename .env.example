# ------------------------------------------------------------------
# Copy this file to apps/backend/.env and fill in real values.
# Never commit the real .env file.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (source of truth for all application data)
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# Redis (BullMQ queue state + distributed rate-limit counters)
REDIS_URL=redis://localhost:6379

# Elasticsearch (search/index layer only, never source of truth)
ELASTICSEARCH_URL=http://localhost:9200

# Sessions (used for the authenticated cookie session)
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Slack OAuth (https://api.slack.com/apps -> OAuth & Permissions)
# Required bot scope: chat:write, incoming-webhook (optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# Ethereal Email SMTP (https://ethereal.email)
# If left blank, the backend will automatically create a fresh
# Ethereal test account at startup via nodemailer.createTestAccount().
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Worker / scheduling behaviour
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY=2
MAX_EMAILS_PER_HOUR=100

# BullMQ dashboard basic-auth protection
BULLBOARD_USER=admin
BULLBOARD_PASSWORD=change-me
